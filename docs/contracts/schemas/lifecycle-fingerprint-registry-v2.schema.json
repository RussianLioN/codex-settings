{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-settings.local/schemas/lifecycle-fingerprint-registry-v2.schema.json",
  "title": "lifecycle-fingerprint-registry-v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "canonicalization", "executionPlan", "abortPlan", "recoveryPlan", "cleanupPlan", "stateBundle", "journalState", "operationJournal", "cleanupJournal", "terminalState", "activationPreparationDefinition", "activationPreparationIntent", "preparationLogicalObject", "activationPreparationStep", "activationPreparationJournal", "activationPreparationFrozenJournal", "databaseBindingTarget", "activationPreparationReceipt", "databaseBinding", "databasePredicates", "activationCommitReceipt", "operationAbortReceipt", "installationUninstallReceipt", "cleanupReceipt", "installationTombstone", "absenceObservation", "absenceProof", "absenceProofProjection", "activationGate", "controllerCandidate", "shutdownIntent", "swapPair", "watchdogState", "stepAction", "lifecycleCommandResult", "controllerRequest", "controllerCommandResult", "controllerResponse"],
  "properties": {
    "schemaVersion": {"const": 2},
    "canonicalization": {"const": "canonical-json-v1"},
    "executionPlan": {"$ref": "#/$defs/spec", "properties": {"domain": {"const": "codex-smart/execution-plan-definition/v2"}, "projectionFields": {"const": ["planId", "machineId", "selectedBranchId", "selectionSource", "composedStepKinds"]}, "excludedFields": {"const": ["firstIncompleteOrdinal", "planDefinitionFingerprint"]}}},
    "abortPlan": {"$ref": "#/$defs/spec", "properties": {"domain": {"const": "codex-smart/abort-plan-definition/v2"}, "projectionFields": {"const": ["planId", "machineId", "selectedBranchId", "selectionSource", "sourceExecutionPlanDefinitionFingerprint", "sourceCompletedForwardStepKinds", "composedStepKinds"]}, "excludedFields": {"const": ["firstIncompleteOrdinal", "planDefinitionFingerprint"]}}},
    "recoveryPlan": {"$ref": "#/$defs/spec", "properties": {"domain": {"const": "codex-smart/recovery-plan-definition/v2"}, "projectionFields": {"const": ["planId", "selectedRecoveryBranchId", "selectionSource", "sourcePlanDefinitionFingerprint", "sourceStepState", "firstIncompleteOrdinal", "firstIncompleteKind", "firstIncompleteStepId", "firstIncompleteActionFingerprint", "controllerPrerequisite", "candidateId", "overlayStepKinds"]}, "excludedFields": {"const": ["status", "overlayCursorOrdinal", "planDefinitionFingerprint"]}}},
    "cleanupPlan": {"$ref": "#/$defs/spec", "properties": {"domain": {"const": "codex-smart/cleanup-plan-definition/v2"}, "projectionFields": {"const": ["planId", "selectionSource", "objectOrderIds", "terminalStepKind"]}, "excludedFields": {"const": ["firstIncompleteOrdinal", "planDefinitionFingerprint"]}}},
    "stateBundle": {"$ref": "#/$defs/spec", "properties": {"domain": {"const": "codex-smart/state-bundle/v2"}, "projectionFields": {"const": ["fileObjects", "treeObjects", "symlinks", "manifest", "activation", "database", "controller", "controllerCandidates", "watchdogs", "registry", "launchers", "legacyProcesses", "quiescence", "externalCommands", "receipts", "absenceProofs"]}, "excludedFields": {"const": ["bundleFingerprint"]}}},
