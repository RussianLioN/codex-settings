        "terminalStateFingerprint": {"$ref": "#/$defs/sha256"},
        "completedStepIds": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "pattern": "^st2_[0-9a-f]{32}$"}},
        "postFreezeActionKinds": {
