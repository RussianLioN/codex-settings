          "properties": {"payloadKind": {"const": "activation-commit"}, "installationId": {"type": "string", "pattern": "^ins2_[0-9a-f]{32}$"}, "operationId": {"type": "string", "pattern": "^op2_[0-9a-f]{32}$"}, "manifest": {"$ref": "#/$defs/typedManifest"}, "manifestDocument": {"$ref": "manifest-document-v2.schema.json"}, "transitionLineage": {"$ref": "activation-commit-receipt-v2.schema.json#/$defs/transitionLineage"}, "activation": {"$ref": "#/$defs/typedActivation"}, "databaseBinding": {"$ref": "#/$defs/typedDatabaseBinding"}, "journalAbsenceTarget": {"$ref": "#/$defs/typedAbsence"}, "controllerIdentity": {"$ref": "#/$defs/sha256"}, "completedStepIds": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "pattern": "^st2_[0-9a-f]{32}$"}}, "completedAt": {"type": "string", "format": "date-time"}}
        },
