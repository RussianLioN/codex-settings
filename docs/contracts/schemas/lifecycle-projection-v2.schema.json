        "status": {"enum": ["EXPECTED_MARKETPLACE_REGISTERED", "MARKETPLACE_REGISTERED", "EXPECTED_PLUGIN_ENABLED", "PLUGIN_ENABLED"]},
        "marketplaceName": {"const": "codex-settings-adaptive"},
