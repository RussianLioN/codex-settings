{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-settings.local/schemas/role-template-v1.schema.json",
  "title": "role-template-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractVersion",
    "templateId",
    "semanticRole",
    "executionProfile",
    "objective",
    "requiredContextKinds",
    "requiredEvidenceKinds",
    "requiredOutputFields",
    "completionConditions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "contractVersion": {
      "const": "codex-role-template-v1"
    },
    "templateId": {
      "type": "string",
      "pattern": "^(researcher|diagnostician|validator|risk_auditor|implementer)-v1$"
    },
    "semanticRole": {
      "enum": [
        "researcher",
        "diagnostician",
        "validator",
        "risk_auditor",
        "implementer"
      ]
    },
    "executionProfile": {
      "enum": [
        "reader",
        "writer"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "requiredContextKinds": {
      "$ref": "#/$defs/nonEmptyStringSet"
    },
    "requiredEvidenceKinds": {
      "$ref": "#/$defs/nonEmptyStringSet"
    },
    "requiredOutputFields": {
      "$ref": "#/$defs/nonEmptyStringSet"
    },
    "completionConditions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    }
  },
  "$defs": {
    "nonEmptyStringSet": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    }
  }
}
