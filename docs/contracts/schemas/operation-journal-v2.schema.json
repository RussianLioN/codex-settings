          "properties": {"payloadKind": {"const": "operation-abort"}, "installationId": {"type": "string", "pattern": "^ins2_[0-9a-f]{32}$"}, "operationId": {"type": "string", "pattern": "^op2_[0-9a-f]{32}$"}, "restoredState": {"$ref": "#/$defs/stateBundle"}, "journalAbsenceTarget": {"$ref": "#/$defs/typedAbsence"}, "reasonCode": {"type": "string", "minLength": 1, "maxLength": 128}, "completedAt": {"type": "string", "format": "date-time"}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["payloadKind", "installationId", "operationId", "removedState", "restoredOriginalBackup", "absenceProof", "dataRetentionMode", "retainedData", "activationProofFingerprint", "completedAt"],
          "properties": {"payloadKind": {"const": "installation-uninstall"}, "installationId": {"type": "string", "pattern": "^ins2_[0-9a-f]{32}$"}, "operationId": {"type": "string", "pattern": "^op2_[0-9a-f]{32}$"}, "removedState": {"$ref": "#/$defs/stateBundle"}, "restoredOriginalBackup": {"oneOf": [{"$ref": "lifecycle-projection-v2.schema.json", "properties": {"schemaId": {"const": "file-object-v2"}}}, {"$ref": "#/$defs/typedAbsence"}]}, "absenceProof": {"$ref": "#/$defs/typedAbsence"}, "dataRetentionMode": {"const": "retain-data"}, "retainedData": {"$ref": "#/$defs/uninstallRetainedData"}, "activationProofFingerprint": {"$ref": "#/$defs/sha256"}, "completedAt": {"type": "string", "format": "date-time"}}
