    "activationPreparationReceipt": {"$ref": "#/$defs/spec", "properties": {"domain": {"const": "codex-smart/activation-preparation-receipt/v2"}, "projectionFields": {"const": ["schemaVersion", "receiptKind", "installationId", "operationId", "activationIntent", "snapshotFile", "activationTree", "activationFile", "databaseEmptyFile", "databaseBindingTarget", "desired", "frozenJournalFingerprint", "completedAt"]}, "excludedFields": {"const": ["receiptFingerprint"]}}},
