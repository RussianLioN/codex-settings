            "watchdogId": {"type": "string", "pattern": "^wd2_[0-9a-f]{32}$"},
            "pid": {"type": "integer", "minimum": 1, "maximum": 2147483647},
            "processStartMarker": {"type": "string", "minLength": 1, "maxLength": 256},
            "processGroupId": {"type": "integer", "minimum": 1, "maximum": 2147483647},
            "state": {"const": "ARMED"},
            "proofFingerprint": {"$ref": "#/$defs/sha256"}
          }
        },
        "gatewayFenceProofFingerprint": {"$ref": "#/$defs/sha256"},
        "bridgeFenceProofFingerprint": {"$ref": "#/$defs/sha256"},
        "databaseFile": {"$ref": "#/$defs/fileObject"},
        "databaseIdentityFingerprint": {"$ref": "#/$defs/sha256"},
        "databaseSnapshotFingerprint": {"$ref": "#/$defs/sha256"},
        "exclusiveDatabaseLeaseProofFingerprint": {"$ref": "#/$defs/sha256"},
        "externalBarrierProofFingerprint": {"$ref": "#/$defs/sha256"},
        "workCounts": {"$ref": "#/$defs/zeroWorkCounts"},
