{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-settings.local/schemas/activation-preparation-receipt-v2.schema.json",
  "title": "activation-preparation-receipt-v2",
  "description": "Неизменяемая квитанция полностью подготовленной неактивной активации и будущей привязки базы.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "receiptKind", "installationId", "operationId", "activationIntent", "snapshotFile", "activationTree", "activationFile", "databaseEmptyFile", "databaseBindingTarget", "desired", "frozenJournalFingerprint", "completedAt", "receiptFingerprint"],
  "properties": {
    "schemaVersion": {"const": 2},
    "receiptKind": {"const": "activation-preparation"},
    "installationId": {"$ref": "activation-preparation-journal-v2.schema.json#/$defs/installationId"},
    "operationId": {"$ref": "activation-preparation-journal-v2.schema.json#/$defs/operationId"},
    "activationIntent": {"$ref": "activation-preparation-journal-v2.schema.json#/$defs/activationIntent"},
    "snapshotFile": {"$ref": "activation-preparation-journal-v2.schema.json#/$defs/fileProjection"},
    "activationTree": {"$ref": "activation-preparation-journal-v2.schema.json#/$defs/treeProjection"},
    "activationFile": {"$ref": "activation-preparation-journal-v2.schema.json#/$defs/fileProjection"},
    "databaseEmptyFile": {"$ref": "activation-preparation-journal-v2.schema.json#/$defs/fileProjection"},
    "databaseBindingTarget": {
      "allOf": [
        {"$ref": "lifecycle-projection-v2.schema.json"},
        {"properties": {"schemaId": {"const": "database-binding-target-v2"}}}
      ]
    },
    "preparedManifestFile": {"$ref": "activation-preparation-journal-v2.schema.json#/$defs/fileProjection"},
    "preparedManifestParent": {"$ref": "activation-preparation-journal-v2.schema.json#/$defs/directoryBindingProjection"},
    "transitionProofSnapshot": {"$ref": "activation-transition-proof-snapshot-v2.schema.json"},
    "desired": {"$ref": "operation-journal-v2.schema.json#/$defs/stateBundle"},
    "frozenJournalFingerprint": {"$ref": "activation-preparation-journal-v2.schema.json#/$defs/sha256"},
    "completedAt": {"$ref": "activation-preparation-journal-v2.schema.json#/$defs/timestamp"},
    "receiptFingerprint": {"$ref": "activation-preparation-journal-v2.schema.json#/$defs/sha256"}
  },
  "dependentRequired": {
    "preparedManifestFile": ["preparedManifestParent", "transitionProofSnapshot"],
    "preparedManifestParent": ["preparedManifestFile", "transitionProofSnapshot"],
    "transitionProofSnapshot": ["preparedManifestFile", "preparedManifestParent"]
  }
}
