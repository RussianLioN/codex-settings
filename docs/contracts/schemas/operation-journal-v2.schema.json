        {"properties": {"before": {"$ref": "lifecycle-projection-v2.schema.json", "properties": {"schemaId": {"const": "file-object-v2"}}}, "replacementAuthorization": {"const": "REPLACE_VERIFIED_STALE_PRIOR_INSTALLATION"}, "priorInstallationEvidence": {"type": "object"}}}
