{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-settings.local/schemas/boundary-result-v1.schema.json",
  "title": "boundary-result-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "criterionStates",
    "q",
    "p",
    "v",
    "o",
    "hardFloorReasons",
    "hardFloor",
    "hardBan"
  ],
  "properties": {
    "criterionStates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "q",
        "p",
        "v",
        "o"
      ],
      "properties": {
        "q": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "q1-dependent-chain",
            "q1-bounded-tradeoff",
            "q2-cross-boundary-invariant",
            "q2-adversarial-concurrency",
            "q2-conflict-synthesis"
          ],
          "properties": {
            "q1-dependent-chain": {
              "type": "string",
              "enum": [
                "false",
                "true",
                "unknown",
                "conflict"
              ]
            },
            "q1-bounded-tradeoff": {
              "type": "string",
              "enum": [
                "false",
                "true",
                "unknown",
                "conflict"
              ]
            },
            "q2-cross-boundary-invariant": {
              "type": "string",
              "enum": [
                "false",
                "true",
                "unknown",
                "conflict"
              ]
            },
            "q2-adversarial-concurrency": {
              "type": "string",
              "enum": [
                "false",
                "true",
                "unknown",
                "conflict"
              ]
            },
            "q2-conflict-synthesis": {
              "type": "string",
              "enum": [
                "false",
                "true",
                "unknown",
                "conflict"
              ]
            }
          }
        },
        "p": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "p1-scope-2-to-5",
            "p2-scope-6-plus",
            "p2-boundaries-2-plus",
            "p2-workstreams-2-plus"
          ],
          "properties": {
            "p1-scope-2-to-5": {
              "type": "string",
              "enum": [
                "false",
                "true",
                "unknown",
                "conflict"
              ]
            },
            "p2-scope-6-plus": {
              "type": "string",
              "enum": [
                "false",
                "true",
                "unknown",
                "conflict"
              ]
            },
            "p2-boundaries-2-plus": {
              "type": "string",
              "enum": [
                "false",
                "true",
                "unknown",
                "conflict"
              ]
            },
            "p2-workstreams-2-plus": {
              "type": "string",
              "enum": [
                "false",
                "true",
                "unknown",
                "conflict"
              ]
            }
          }
        },
        "v": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "v1-reversible-persistent",
            "v1-user-visible-isolated",
            "v2-shared-or-production",
            "v2-destructive-or-unproven-rollback",
            "v2-trust-secret-permission",
            "v2-high-stakes",
            "v2-release-or-migration"
          ],
          "properties": {
            "v1-reversible-persistent": {
              "type": "string",
              "enum": [
                "false",
                "true",
                "unknown",
                "conflict"
              ]
            },
            "v1-user-visible-isolated": {
              "type": "string",
              "enum": [
                "false",
                "true",
                "unknown",
                "conflict"
              ]
            },
            "v2-shared-or-production": {
              "type": "string",
              "enum": [
                "false",
                "true",
                "unknown",
                "conflict"
              ]
            },
            "v2-destructive-or-unproven-rollback": {
              "type": "string",
              "enum": [
                "false",
                "true",
                "unknown",
                "conflict"
              ]
            },
            "v2-trust-secret-permission": {
              "type": "string",
              "enum": [
                "false",
                "true",
                "unknown",
                "conflict"
              ]
            },
            "v2-high-stakes": {
              "type": "string",
              "enum": [
                "false",
                "true",
                "unknown",
                "conflict"
              ]
            },
            "v2-release-or-migration": {
              "type": "string",
              "enum": [
                "false",
                "true",
                "unknown",
                "conflict"
              ]
            }
          }
        },
        "o": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "o1-discoverable-missing-fact",
            "o1-mutable-current-state",
            "o1-explicit-reversible-assumption",
            "o2-authority-conflict",
            "o2-undiscoverable-required-fact",
            "o2-unreproducible-conflict",
            "o2-uncontracted-interface"
          ],
          "properties": {
            "o1-discoverable-missing-fact": {
              "type": "string",
              "enum": [
                "false",
                "true",
                "unknown",
                "conflict"
              ]
            },
            "o1-mutable-current-state": {
              "type": "string",
              "enum": [
                "false",
                "true",
                "unknown",
                "conflict"
              ]
            },
            "o1-explicit-reversible-assumption": {
              "type": "string",
              "enum": [
                "false",
                "true",
                "unknown",
                "conflict"
              ]
            },
            "o2-authority-conflict": {
              "type": "string",
              "enum": [
                "false",
                "true",
                "unknown",
                "conflict"
              ]
            },
            "o2-undiscoverable-required-fact": {
              "type": "string",
              "enum": [
                "false",
                "true",
                "unknown",
                "conflict"
              ]
            },
            "o2-unreproducible-conflict": {
              "type": "string",
              "enum": [
                "false",
                "true",
                "unknown",
                "conflict"
              ]
            },
            "o2-uncontracted-interface": {
              "type": "string",
              "enum": [
                "false",
                "true",
                "unknown",
                "conflict"
              ]
            }
          }
        }
      }
    },
    "q": {
      "$ref": "#/$defs/interval"
    },
    "p": {
      "$ref": "#/$defs/interval"
    },
    "v": {
      "$ref": "#/$defs/interval"
    },
    "o": {
      "$ref": "#/$defs/interval"
    },
    "hardFloorReasons": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "architecture-decision",
          "public-contract",
          "risky-migration",
          "security-sensitive",
          "critical-incident",
          "final-author-review-before-publish",
          "irreversible-action",
          "rollback-unproven"
        ]
      }
    },
    "hardFloor": {
      "type": "string",
      "enum": [
        "none",
        "terra",
        "sol"
      ]
    },
    "hardBan": {
      "type": "string",
      "enum": [
        "none",
        "direct",
        "clarify"
      ]
    }
  },
  "$defs": {
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        }
      }
    }
  }
}
