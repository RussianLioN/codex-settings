      "oneOf": [
        {"properties": {"status": {"const": "RUNNING"}, "signalSent": {"type": "null"}, "exitProofFingerprint": {"type": "null"}}},
        {"properties": {"status": {"const": "EXITED"}, "signalSent": {"enum": [null, "SIGTERM"]}, "exitProofFingerprint": {"$ref": "#/$defs/sha256"}}},
        {"properties": {"status": {"const": "MARKER_MISMATCH"}, "signalSent": {"enum": [null, "SIGTERM"]}, "exitProofFingerprint": {"$ref": "#/$defs/sha256"}}},
        {"properties": {"status": {"const": "EXTERNAL_PROCESS_STILL_RUNNING"}, "signalSent": {"const": "SIGTERM"}, "exitProofFingerprint": {"type": "null"}}}
      ]
    },
