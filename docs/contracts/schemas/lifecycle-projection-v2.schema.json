    "externalCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["externalCommandId", "commandKind", "argvFingerprint", "observer", "target", "deadlineMonotonicMs", "signalPolicy", "signalSent", "status", "observationProofFingerprint", "exitProofFingerprint"],
      "properties": {
        "externalCommandId": {"type": "string", "pattern": "^ec2_[0-9a-f]{32}$"},
