{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-settings.local/schemas/activation-transition-proof-snapshot-v2.schema.json",
  "title": "activation-transition-proof-snapshot-v2",
  "description": "Неизменяемый снимок доказательства старой принятой активации для восстановления после замены ссылки или манифеста.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "snapshotKind", "operationId", "codexHome",
    "manifestPath", "marketplaceLinkPath", "installationId", "activationId",
    "activationFingerprint", "currentOperationId", "stateHome", "databasePath",
    "activationDir", "manifestRawSha256", "manifestDocument",
    "manifestFileProjection", "manifestProjection", "activePointer",
    "linkTarget", "linkDevice", "linkInode", "linkProjection",
    "activationRawSha256", "activationDocument", "activationTreeProjection",
    "activationProjection", "commitReceiptPath", "commitReceiptRawSha256",
    "commitReceiptDocument", "commitReceiptFileProjection",
    "commitReceiptProjection", "databaseBinding", "databaseIdentityRow",
    "controllerRow", "controllerIdentity", "installerReceiptPath",
    "installerReceiptRawSha256", "installerReceiptDocument",
    "installerReceiptFileProjection", "installerReceiptProjection",
    "activationProofFingerprint", "snapshotFingerprint"
  ],
  "properties": {
    "schemaVersion": {"const": 2},
    "snapshotKind": {"const": "activation-transition-proof"},
    "operationId": {"$ref": "activation-preparation-journal-v2.schema.json#/$defs/operationId"},
    "codexHome": {"$ref": "#/$defs/absolutePath"},
    "manifestPath": {"$ref": "#/$defs/absolutePath"},
    "marketplaceLinkPath": {"$ref": "#/$defs/absolutePath"},
    "installationId": {"$ref": "activation-preparation-journal-v2.schema.json#/$defs/installationId"},
    "activationId": {"$ref": "activation-preparation-journal-v2.schema.json#/$defs/activationId"},
    "activationFingerprint": {"$ref": "#/$defs/sha256"},
    "currentOperationId": {"$ref": "activation-preparation-journal-v2.schema.json#/$defs/operationId"},
    "stateHome": {"$ref": "#/$defs/absolutePath"},
    "databasePath": {"$ref": "#/$defs/absolutePath"},
    "activationDir": {"$ref": "#/$defs/absolutePath"},
    "manifestRawSha256": {"$ref": "#/$defs/sha256"},
    "manifestDocument": {"type": "object"},
    "manifestFileProjection": {"$ref": "lifecycle-projection-v2.schema.json#/$defs/fileObject"},
    "manifestProjection": {"$ref": "#/$defs/manifestProjection"},
    "activePointer": {"type": "object"},
    "linkTarget": {"type": "string", "minLength": 1, "maxLength": 4096, "not": {"pattern": "^/"}},
    "linkDevice": {"$ref": "#/$defs/safeInteger"},
    "linkInode": {"$ref": "#/$defs/safeInteger"},
    "linkProjection": {"$ref": "#/$defs/linkProjection"},
    "activationRawSha256": {"$ref": "#/$defs/sha256"},
    "activationDocument": {"type": "object"},
    "activationTreeProjection": {"$ref": "#/$defs/treeProjection"},
    "activationProjection": {"$ref": "#/$defs/activationProjection"},
    "commitReceiptPath": {"$ref": "#/$defs/absolutePath"},
    "commitReceiptRawSha256": {"$ref": "#/$defs/sha256"},
    "commitReceiptDocument": {"type": "object"},
    "commitReceiptFileProjection": {"$ref": "lifecycle-projection-v2.schema.json#/$defs/fileObject"},
    "commitReceiptProjection": {"$ref": "#/$defs/receiptProjection"},
    "databaseBinding": {"$ref": "#/$defs/databaseBindingProjection"},
    "databaseIdentityRow": {"type": "object", "minProperties": 1},
    "controllerRow": {"type": "object", "minProperties": 1},
    "controllerIdentity": {"$ref": "#/$defs/sha256"},
    "installerReceiptPath": {"$ref": "#/$defs/absolutePath"},
    "installerReceiptRawSha256": {"$ref": "#/$defs/sha256"},
    "installerReceiptDocument": {"type": "object"},
    "installerReceiptFileProjection": {"$ref": "lifecycle-projection-v2.schema.json#/$defs/fileObject"},
    "installerReceiptProjection": {"$ref": "#/$defs/fileProjection"},
    "activationProofFingerprint": {"$ref": "#/$defs/sha256"},
    "snapshotFingerprint": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "absolutePath": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "safeInteger": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "manifestProjection": {"$ref": "lifecycle-projection-v2.schema.json", "properties": {"schemaId": {"const": "manifest-v2"}}},
    "linkProjection": {"$ref": "lifecycle-projection-v2.schema.json", "properties": {"schemaId": {"const": "symlink-object-v2"}}},
    "treeProjection": {"$ref": "lifecycle-projection-v2.schema.json", "properties": {"schemaId": {"const": "tree-object-v2"}}},
    "activationProjection": {"$ref": "lifecycle-projection-v2.schema.json", "properties": {"schemaId": {"const": "activation-v2"}}},
    "receiptProjection": {"$ref": "lifecycle-projection-v2.schema.json", "properties": {"schemaId": {"const": "receipt-object-v2"}}},
    "databaseBindingProjection": {"$ref": "lifecycle-projection-v2.schema.json", "properties": {"schemaId": {"const": "database-binding-v2"}}},
    "fileProjection": {"$ref": "lifecycle-projection-v2.schema.json", "properties": {"schemaId": {"const": "file-object-v2"}}}
  }
}
