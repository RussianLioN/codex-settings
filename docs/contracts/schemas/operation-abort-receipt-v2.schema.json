{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-settings.local/schemas/operation-abort-receipt-v2.schema.json",
  "title": "operation-abort-receipt-v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "receiptKind", "installationId", "operationId", "frozenJournalFingerprint", "restoredState", "journalAbsenceTarget", "reasonCode", "receiptFingerprint", "completedAt"],
  "properties": {
    "schemaVersion": {"const": 2},
    "receiptKind": {"const": "operation-abort"},
    "installationId": {"type": "string", "pattern": "^ins2_[0-9a-f]{32}$"},
    "operationId": {"type": "string", "pattern": "^op2_[0-9a-f]{32}$"},
    "frozenJournalFingerprint": {"$ref": "#/$defs/sha256"},
    "restoredState": {"$ref": "operation-journal-v2.schema.json#/$defs/stateBundle"},
    "journalAbsenceTarget": {"$ref": "lifecycle-projection-v2.schema.json", "properties": {"schemaId": {"const": "absence-proof-v2"}}},
    "reasonCode": {"type": "string", "minLength": 1, "maxLength": 128},
    "receiptFingerprint": {"$ref": "#/$defs/sha256"},
    "completedAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
