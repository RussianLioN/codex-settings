      "type": "object",
      "additionalProperties": false,
      "required": ["path", "basename", "parentDevice", "parentInode", "absent"],
      "properties": {
        "path": {"$ref": "#/$defs/absolutePath"},
        "basename": {"type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[^/]+$"},
        "parentDevice": {"$ref": "#/$defs/safeInteger"},
        "parentInode": {"$ref": "#/$defs/safeInteger"},
        "absent": {"const": true}
      }
    },
    "absenceObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observationId", "installationId", "operationId", "entries", "directorySyncCompleted", "observationFingerprint"],
      "properties": {
        "observationId": {"type": "string", "pattern": "^ao2_[0-9a-f]{32}$"},
        "installationId": {"type": "string", "pattern": "^ins2_[0-9a-f]{32}$"},
        "operationId": {"type": "string", "pattern": "^(op2|cl2)_[0-9a-f]{32}$"},
        "entries": {"type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/absenceEntry"}},
        "directorySyncCompleted": {"const": false},
        "observationFingerprint": {"$ref": "#/$defs/sha256"}
      }
    },
    "absenceProof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proofId", "installationId", "operationId", "entries", "directorySyncCompleted", "proofFingerprint"],
      "properties": {
        "proofId": {"type": "string", "pattern": "^ap2_[0-9a-f]{32}$"},
        "installationId": {"type": "string", "pattern": "^ins2_[0-9a-f]{32}$"},
        "operationId": {"type": "string", "pattern": "^(op2|cl2)_[0-9a-f]{32}$"},
        "entries": {"type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/absenceEntry"}},
        "directorySyncCompleted": {"const": true},
        "proofFingerprint": {"$ref": "#/$defs/sha256"}
      }
    }
