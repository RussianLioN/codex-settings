  "$defs": {
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "projectionFields", "excludedFields"],
      "properties": {
        "domain": {"type": "string", "minLength": 1, "maxLength": 128},
        "projectionFields": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "excludedFields": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}}
      }
    }
  }
}
