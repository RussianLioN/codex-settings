{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-settings.local/schemas/rollback-manifest-preparation-receipt-v2.schema.json",
  "title": "rollback-manifest-preparation-receipt-v2",
  "description": "Неизменяемая квитанция source-манифеста отката и точной expectedAfter-проекции manifest_restore.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "receiptKind", "installationId", "operationId", "currentOperationId", "previousOperationId", "currentActivationId", "previousActivationId", "evidenceFingerprint", "preparationIntentFingerprint", "currentPreparationReceiptPath", "currentPreparationReceiptFingerprint", "currentPreparationReceiptSha256", "transitionProofSnapshotFingerprint", "targetPath", "preparedPath", "preparedManifestFile", "preparedManifestParent", "manifestDocument", "manifestRawSha256", "previousActivationTreeSha256", "expectedAfter", "frozenJournalFingerprint", "completedAt", "receiptFingerprint"],
  "properties": {
    "schemaVersion": {"const": 2},
    "receiptKind": {"const": "rollback-manifest-preparation"},
    "installationId": {"$ref": "rollback-manifest-preparation-journal-v2.schema.json#/$defs/installationId"},
    "operationId": {"$ref": "rollback-manifest-preparation-journal-v2.schema.json#/$defs/operationId"},
    "currentOperationId": {"$ref": "rollback-manifest-preparation-journal-v2.schema.json#/$defs/operationId"},
    "previousOperationId": {"$ref": "rollback-manifest-preparation-journal-v2.schema.json#/$defs/operationId"},
    "currentActivationId": {"$ref": "rollback-manifest-preparation-journal-v2.schema.json#/$defs/activationId"},
    "previousActivationId": {"$ref": "rollback-manifest-preparation-journal-v2.schema.json#/$defs/activationId"},
    "evidenceFingerprint": {"$ref": "rollback-manifest-preparation-journal-v2.schema.json#/$defs/sha256"},
    "preparationIntentFingerprint": {"$ref": "rollback-manifest-preparation-journal-v2.schema.json#/$defs/sha256"},
    "currentPreparationReceiptPath": {"$ref": "rollback-manifest-preparation-journal-v2.schema.json#/$defs/absolutePath"},
    "currentPreparationReceiptFingerprint": {"$ref": "rollback-manifest-preparation-journal-v2.schema.json#/$defs/sha256"},
    "currentPreparationReceiptSha256": {"$ref": "rollback-manifest-preparation-journal-v2.schema.json#/$defs/sha256"},
    "transitionProofSnapshotFingerprint": {"$ref": "rollback-manifest-preparation-journal-v2.schema.json#/$defs/sha256"},
    "targetPath": {"$ref": "rollback-manifest-preparation-journal-v2.schema.json#/$defs/absolutePath"},
    "preparedPath": {"$ref": "rollback-manifest-preparation-journal-v2.schema.json#/$defs/absolutePath"},
    "preparedManifestFile": {"allOf": [{"$ref": "lifecycle-projection-v2.schema.json"}, {"properties": {"schemaId": {"const": "file-object-v2"}}}]},
    "preparedManifestParent": {"allOf": [{"$ref": "lifecycle-projection-v2.schema.json"}, {"properties": {"schemaId": {"const": "directory-binding-v2"}}}]},
    "manifestDocument": {"$ref": "rollback-manifest-preparation-journal-v2.schema.json#/$defs/manifestDocument"},
    "manifestRawSha256": {"$ref": "rollback-manifest-preparation-journal-v2.schema.json#/$defs/sha256"},
    "previousActivationTreeSha256": {"$ref": "rollback-manifest-preparation-journal-v2.schema.json#/$defs/sha256"},
    "expectedAfter": {"allOf": [{"$ref": "lifecycle-projection-v2.schema.json"}, {"properties": {"schemaId": {"const": "manifest-v2"}}}]},
    "frozenJournalFingerprint": {"$ref": "rollback-manifest-preparation-journal-v2.schema.json#/$defs/sha256"},
    "completedAt": {"$ref": "rollback-manifest-preparation-journal-v2.schema.json#/$defs/timestamp"},
    "receiptFingerprint": {"$ref": "rollback-manifest-preparation-journal-v2.schema.json#/$defs/sha256"}
