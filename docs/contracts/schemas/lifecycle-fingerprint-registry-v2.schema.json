    "operationAbortReceipt": {"$ref": "#/$defs/spec", "properties": {"domain": {"const": "codex-smart/operation-abort-receipt/v2"}, "projectionFields": {"const": ["schemaVersion", "receiptKind", "installationId", "operationId", "frozenJournalFingerprint", "restoredState", "journalAbsenceTarget", "reasonCode", "completedAt"]}, "excludedFields": {"const": ["receiptFingerprint"]}}},
    "installationUninstallReceipt": {"$ref": "#/$defs/spec", "properties": {"domain": {"const": "codex-smart/installation-uninstall-receipt/v2"}, "projectionFields": {"const": ["schemaVersion", "receiptKind", "installationId", "operationId", "frozenJournalFingerprint", "dataRetentionMode", "retainedData", "removedState", "restoredOriginalBackup", "absenceProof", "completedAt"]}, "excludedFields": {"const": ["receiptFingerprint"]}}},
    "cleanupReceipt": {"$ref": "#/$defs/spec", "properties": {"domain": {"const": "codex-smart/cleanup-receipt/v2"}, "projectionFields": {"const": ["schemaVersion", "receiptKind", "cleanupId", "installationId", "frozenJournalFingerprint", "baseCommitReceipt", "removedObjects", "absenceProof", "completedAt"]}, "excludedFields": {"const": ["receiptFingerprint"]}}},
    "installationTombstone": {"$ref": "#/$defs/spec", "properties": {"domain": {"const": "codex-smart/installation-tombstone/v2"}, "projectionFields": {"const": ["schemaVersion", "installationId", "operationId", "uninstallReceipt", "absenceProof", "completedAt"]}, "excludedFields": {"const": ["tombstoneFingerprint"]}}},
    "absenceObservation": {"$ref": "#/$defs/spec", "properties": {"domain": {"const": "codex-smart/absence-observation/v2"}, "projectionFields": {"const": ["observationId", "installationId", "operationId", "entries", "directorySyncCompleted"]}, "excludedFields": {"const": ["observationFingerprint"]}}},
