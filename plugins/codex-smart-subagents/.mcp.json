{
  "mcpServers": {
    "codex-smart-subagents": {
      "command": "./bin/codex-smart-subagents-mcp",
      "args": [
        "--stdio"
      ],
      "cwd": ".",
      "env_vars": [
        "CODEX_ADAPTIVE_SESSION_ID",
        "CODEX_ADAPTIVE_CATALOG",
        "CODEX_HOME",
        "XDG_STATE_HOME"
      ],
      "startup_timeout_sec": 5,
      "tool_timeout_sec": 430,
      "required": false,
      "enabled_tools": [
        "smart_plan",
        "smart_start",
        "smart_wait",
        "smart_cancel"
      ],
      "default_tools_approval_mode": "auto"
    }
  }
}
