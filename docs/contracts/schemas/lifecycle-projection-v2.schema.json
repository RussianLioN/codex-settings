        "configFile": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/fileObject"}]},
        "configSemanticFingerprint": {"$ref": "#/$defs/sha256"},
        "marketplaceListFingerprint": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
