    "absenceProofProjection": {"$ref": "#/$defs/spec", "properties": {"domain": {"const": "codex-smart/absence-proof-projection/v2"}, "projectionFields": {"const": ["schemaId", "schemaSha256", "value"]}, "excludedFields": {"const": ["valueFingerprint"]}}},
    "activationGate": {"$ref": "#/$defs/spec", "properties": {"domain": {"const": "codex-smart/activation-gate/v2"}, "projectionFields": {"const": ["manifestSemanticFingerprint", "activationReceiptFingerprint", "journalAbsenceProof"]}, "excludedFields": {"const": ["gateFingerprint"]}}},
    "controllerCandidate": {"$ref": "#/$defs/spec", "properties": {"domain": {"const": "codex-smart/controller-candidate/v2"}, "projectionFields": {"const": ["schemaId", "schemaSha256", "value"]}, "excludedFields": {"const": ["valueFingerprint"]}}},
    "shutdownIntent": {"$ref": "#/$defs/spec", "properties": {"domain": {"const": "codex-smart/shutdown-intent/v2"}, "projectionFields": {"const": ["schemaId", "schemaSha256", "value"]}, "excludedFields": {"const": ["valueFingerprint"]}}},
    "swapPair": {"$ref": "#/$defs/spec", "properties": {"domain": {"const": "codex-smart/swap-pair/v2"}, "projectionFields": {"const": ["schemaId", "schemaSha256", "value"]}, "excludedFields": {"const": ["valueFingerprint"]}}},
    "watchdogState": {"$ref": "#/$defs/spec", "properties": {"domain": {"const": "codex-smart/watchdog-state/v2"}, "projectionFields": {"const": ["schemaId", "schemaSha256", "value"]}, "excludedFields": {"const": ["valueFingerprint"]}}},
    "stepAction": {"$ref": "#/$defs/spec", "properties": {"domain": {"const": "codex-smart/step-action/v2"}, "projectionFields": {"const": ["action"]}, "excludedFields": {"const": ["actionFingerprint"]}}},
    "lifecycleCommandResult": {"$ref": "#/$defs/spec", "properties": {"domain": {"const": "codex-smart/command-result/v2"}, "projectionFields": {"const": ["schemaVersion", "command", "status", "readiness", "smokeInvocationId", "changes", "problems"]}, "excludedFields": {"const": ["operationId", "attemptId", "resultFingerprint", "problems.message", "problems.remediation", "extensions"]}}},
    "controllerRequest": {"$ref": "#/$defs/spec", "properties": {"domain": {"const": "codex-smart/controller-request/v2"}, "projectionFields": {"const": ["messageType", "protocolVersion", "release", "codexHomeHash", "shellSessionId", "controllerIdentity", "instanceId", "controllerStartId", "commandId", "expectedControlEpoch", "operationId", "method", "params"]}, "excludedFields": {"const": ["requestFingerprint", "extensions"]}}},
    "controllerCommandResult": {"$ref": "#/$defs/spec", "properties": {"domain": {"const": "codex-smart/controller-command-result/v2"}, "projectionFields": {"const": ["method", "payload.status", "payload.previousControlEpoch", "payload.newControlEpoch", "payload.controllerIdentity", "payload.instanceId", "payload.controllerStartId", "payload.socketIntent"]}, "excludedFields": {"const": ["payload.commandReceipt", "responseFingerprint", "extensions"]}}},
    "controllerResponse": {"$ref": "#/$defs/spec", "properties": {"domain": {"const": "codex-smart/controller-response/v2"}, "projectionFields": {"const": ["messageType", "protocolVersion", "release", "method", "responseKind", "commandId", "requestFingerprint", "controlEpoch", "payload"]}, "excludedFields": {"const": ["responseFingerprint", "extensions"]}}}
