        {"properties": {"terminalKind": {"const": "ABORT"}, "receiptKind": {"const": "operation-abort"}, "postFreezeActionKinds": {"const": ["abort_receipt_publish", "abort_journal_close"]}, "receiptPayloadIntent": {"properties": {"payloadKind": {"const": "operation-abort"}}}, "tombstonePayloadIntent": {"type": "null"}}},
