      },
      "oneOf": [
        {"properties": {"status": {"enum": ["EXPECTED_MARKETPLACE_REGISTERED", "EXPECTED_PLUGIN_ENABLED"]}, "configFile": {"type": "null"}, "marketplaceListFingerprint": {"type": "null"}, "pluginListFingerprint": {"type": "null"}}},
        {"properties": {"status": {"enum": ["MARKETPLACE_REGISTERED", "PLUGIN_ENABLED"]}, "configFile": {"$ref": "#/$defs/fileObject"}, "marketplaceListFingerprint": {"$ref": "#/$defs/sha256"}, "pluginListFingerprint": {"$ref": "#/$defs/sha256"}}}
      ],
      "allOf": [
        {"if": {"properties": {"status": {"enum": ["EXPECTED_MARKETPLACE_REGISTERED", "MARKETPLACE_REGISTERED"]}}, "required": ["status"]}, "then": {"properties": {"pluginEnabled": {"const": false}}}},
        {"if": {"properties": {"status": {"enum": ["EXPECTED_PLUGIN_ENABLED", "PLUGIN_ENABLED"]}}, "required": ["status"]}, "then": {"properties": {"pluginEnabled": {"const": true}}}}
      ]
