{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-settings.local/schemas/installer-receipt-v2.schema.json",
  "title": "installer-receipt-v2",
  "description": "Закрытая квитанция установщика. sourceDigest связывает исходное дерево с лексическим путём и содержимым выбранного Codex; marketplacePath хранит лексический вход команды Codex, registeredMarketplacePath — наблюдённый канонический каталог неизменяемой активации.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "sourceDigest",
    "installationId",
    "activationId",
    "codexHome",
    "codexBinary",
    "stateHome",
    "marketplacePath",
    "registeredMarketplacePath",
    "links",
    "marketplaceName",
    "pluginId",
    "extensions"
  ],
  "properties": {
    "schemaVersion": {"const": 2},
    "kind": {"const": "codex-smart-installer-receipt/v2"},
    "sourceDigest": {"$ref": "#/$defs/sha256"},
    "installationId": {"type": "string", "pattern": "^ins2_[0-9a-f]{32}$"},
    "activationId": {"type": "string", "pattern": "^act2_[0-9a-f]{64}$"},
    "codexHome": {"$ref": "#/$defs/absolutePath"},
    "codexBinary": {"$ref": "#/$defs/absolutePath"},
    "stateHome": {"$ref": "#/$defs/absolutePath"},
    "marketplacePath": {"$ref": "#/$defs/absolutePath"},
    "registeredMarketplacePath": {"$ref": "#/$defs/absolutePath"},
    "links": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/link"}
    },
    "marketplaceName": {"const": "codex-settings-adaptive"},
    "pluginId": {"const": "codex-smart-subagents@codex-settings-adaptive"},
    "extensions": {
      "oneOf": [
        {"type": "object", "maxProperties": 0},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["sourceLineage"],
          "properties": {
            "sourceLineage": {"$ref": "#/$defs/sourceLineage"}
          }
        }
      ]
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "absolutePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/[^\\u0000]*$"
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "target"],
      "properties": {
        "path": {"$ref": "#/$defs/absolutePath"},
        "target": {"$ref": "#/$defs/absolutePath"}
      }
    },
    "sourceLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "generation", "implementationDigest"],
      "properties": {
        "schemaVersion": {"const": 1},
        "generation": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "implementationDigest": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
