{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/schemas/codex-wide-wave-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "skill_id",
    "wave_size",
    "repository_root",
    "base_commit",
    "participants"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "skill_id": {"type": "string", "minLength": 1},
    "wave_size": {"type": "integer", "minimum": 1, "maximum": 20},
    "repository_root": {"type": "string", "minLength": 1},
    "base_commit": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
    "participants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "access", "owned_write_scope"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "access": {"type": "string", "enum": ["read-only", "workspace-write", "danger-full-access"]},
          "owned_write_scope": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        }
      }
    }
  }
}
