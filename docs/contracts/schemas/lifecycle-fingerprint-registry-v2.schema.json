    "operationJournal": {"$ref": "#/$defs/spec", "properties": {"domain": {"const": "codex-smart/operation-journal/v2"}, "projectionFields": {"const": ["schemaVersion", "kind", "installationId", "operationId", "operation", "phase", "recoveryPolicy", "executionPlan", "abortPlan", "recoveryPlans", "discoveryBefore", "fencedBefore", "desired", "attempts", "steps", "changes", "terminalDeleteIntent", "createdAt", "updatedAt"]}, "excludedFields": {"const": ["journalFingerprint"]}}},
