{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-settings.local/schemas/rollback-manifest-preparation-journal-v2.schema.json",
  "title": "rollback-manifest-preparation-journal-v2",
  "description": "Долговечный одношаговый журнал подготовки source-манифеста отката до основного журнала.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "journalKind", "installationId", "operationId", "phase", "definitionFingerprint", "definition", "intentBoundary", "steps", "contentGeneration", "createdAt", "updatedAt", "frozenAt", "frozenJournalFingerprint", "journalFingerprint"],
  "properties": {
    "schemaVersion": {"const": 2},
    "journalKind": {"const": "rollback-manifest-preparation"},
    "installationId": {"$ref": "#/$defs/installationId"},
    "operationId": {"$ref": "#/$defs/operationId"},
    "phase": {"enum": ["PREPARING", "PREPARATION_FROZEN"]},
    "definitionFingerprint": {"$ref": "#/$defs/sha256"},
    "definition": {"$ref": "#/$defs/definition"},
    "intentBoundary": {"$ref": "#/$defs/intentBoundary"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "prefixItems": [{"$ref": "#/$defs/step"}],
      "items": false
    },
    "contentGeneration": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "createdAt": {"$ref": "#/$defs/timestamp"},
    "updatedAt": {"$ref": "#/$defs/timestamp"},
    "frozenAt": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/timestamp"}]},
    "frozenJournalFingerprint": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "journalFingerprint": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"phase": {"const": "PREPARING"}}},
      "then": {"properties": {"frozenAt": {"type": "null"}, "frozenJournalFingerprint": {"type": "null"}}}
    },
    {
      "if": {"properties": {"phase": {"const": "PREPARATION_FROZEN"}}},
      "then": {
        "properties": {
          "frozenAt": {"$ref": "#/$defs/timestamp"},
          "frozenJournalFingerprint": {"$ref": "#/$defs/sha256"},
          "steps": {"prefixItems": [{"$ref": "#/$defs/completedStep"}]}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "installationId": {"type": "string", "pattern": "^ins2_[0-9a-f]{32}$"},
    "operationId": {"type": "string", "pattern": "^op2_[0-9a-f]{32}$"},
    "activationId": {"type": "string", "pattern": "^act2_[0-9a-f]{64}$"},
    "absolutePath": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/"},
    "timestamp": {"type": "string", "format": "date-time"},
    "fileValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "device", "inode", "ownerUid", "ownerGid", "mode", "linkCount", "size", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/absolutePath"},
        "device": {"type": "integer", "minimum": 0},
        "inode": {"type": "integer", "minimum": 0},
        "ownerUid": {"type": "integer", "minimum": 0},
        "ownerGid": {"type": "integer", "minimum": 0},
        "mode": {"const": "0600"},
        "linkCount": {"const": 1},
        "size": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "activationPointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activationId", "activationFingerprint", "symlinkTarget", "generationId", "databaseId"],
      "properties": {
        "activationId": {"$ref": "#/$defs/activationId"},
        "activationFingerprint": {"$ref": "#/$defs/sha256"},
        "symlinkTarget": {"type": "string", "minLength": 1, "maxLength": 4096},
        "generationId": {"type": "string", "pattern": "^gen2_[0-9a-f]{64}$"},
        "databaseId": {"type": "string", "pattern": "^db2_[0-9a-f]{32}$"}
      }
    },
    "manifestDocument": {
      "type": "object",
      "required": ["schemaVersion", "installationId", "release", "pluginId", "stateHome", "sourceLocator", "activeActivation", "previousActivation", "artifacts", "lastCommittedOperation", "extensions"],
      "properties": {
        "schemaVersion": {"const": 2},
        "installationId": {"$ref": "#/$defs/installationId"},
        "activeActivation": {"$ref": "#/$defs/activationPointer"},
        "previousActivation": {"$ref": "#/$defs/activationPointer"},
        "lastCommittedOperation": {"$ref": "#/$defs/operationId"},
        "artifacts": {"type": "array", "maxItems": 4096},
        "extensions": {"type": "object", "maxProperties": 128}
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["installationId", "operationId", "currentOperationId", "previousOperationId", "currentActivationId", "previousActivationId", "evidenceFingerprint", "currentPreparationReceiptPath", "currentPreparationReceiptFingerprint", "currentPreparationReceiptSha256", "transitionProofSnapshotFingerprint", "currentManifestRawSha256", "currentManifestFileProjection", "projectionSchemaSha256", "previousActivationTreeSha256", "targetPath", "preparedPath", "manifestDocument", "manifestRawSha256", "intentFingerprint"],
      "properties": {
        "installationId": {"$ref": "#/$defs/installationId"},
        "operationId": {"$ref": "#/$defs/operationId"},
        "currentOperationId": {"$ref": "#/$defs/operationId"},
        "previousOperationId": {"$ref": "#/$defs/operationId"},
        "currentActivationId": {"$ref": "#/$defs/activationId"},
        "previousActivationId": {"$ref": "#/$defs/activationId"},
        "evidenceFingerprint": {"$ref": "#/$defs/sha256"},
        "currentPreparationReceiptPath": {"$ref": "#/$defs/absolutePath"},
        "currentPreparationReceiptFingerprint": {"$ref": "#/$defs/sha256"},
        "currentPreparationReceiptSha256": {"$ref": "#/$defs/sha256"},
        "transitionProofSnapshotFingerprint": {"$ref": "#/$defs/sha256"},
        "currentManifestRawSha256": {"$ref": "#/$defs/sha256"},
        "currentManifestFileProjection": {"$ref": "#/$defs/fileValue"},
        "projectionSchemaSha256": {"$ref": "#/$defs/sha256"},
        "previousActivationTreeSha256": {"$ref": "#/$defs/sha256"},
        "targetPath": {"$ref": "#/$defs/absolutePath"},
        "preparedPath": {"$ref": "#/$defs/absolutePath"},
        "manifestDocument": {"$ref": "#/$defs/manifestDocument"},
        "manifestRawSha256": {"$ref": "#/$defs/sha256"},
        "intentFingerprint": {"$ref": "#/$defs/sha256"}
      }
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["journalPath", "receiptPath", "lockPath", "activationIntent"],
      "properties": {
        "journalPath": {"$ref": "#/$defs/absolutePath"},
        "receiptPath": {"$ref": "#/$defs/absolutePath"},
        "lockPath": {"$ref": "#/$defs/absolutePath"},
        "activationIntent": {"$ref": "#/$defs/intent"}
      }
    },
    "intentBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "state", "intentFingerprint", "completedAt"],
      "properties": {
        "kind": {"const": "preparation_intent"},
        "state": {"const": "COMPLETED"},
        "intentFingerprint": {"$ref": "#/$defs/sha256"},
        "completedAt": {"$ref": "#/$defs/timestamp"}
      }
    },
    "logical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "objectType", "mode", "contentSha256", "logicalFingerprint"],
      "properties": {
        "path": {"$ref": "#/$defs/absolutePath"},
        "objectType": {"const": "regular-file"},
        "mode": {"const": "0600"},
        "contentSha256": {"$ref": "#/$defs/sha256"},
        "logicalFingerprint": {"$ref": "#/$defs/sha256"}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stepId", "ordinal", "kind", "state", "expectedLogical", "observedPhysical", "observedCompanions", "intentAt", "completedAt", "stepFingerprint"],
      "properties": {
        "stepId": {"type": "string", "pattern": "^rpst2_[0-9a-f]{32}$"},
        "ordinal": {"const": 1},
        "kind": {"const": "rollback_manifest_file"},
        "state": {"enum": ["PLANNED", "INTENT_DURABLE", "COMPLETED"]},
        "expectedLogical": {"$ref": "#/$defs/logical"},
        "observedPhysical": {"oneOf": [{"type": "null"}, {"$ref": "lifecycle-projection-v2.schema.json"}]},
        "observedCompanions": {"type": "array", "maxItems": 1, "items": {"$ref": "lifecycle-projection-v2.schema.json"}},
        "intentAt": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/timestamp"}]},
        "completedAt": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/timestamp"}]},
        "stepFingerprint": {"$ref": "#/$defs/sha256"}
      },
      "allOf": [
        {"if": {"properties": {"state": {"const": "PLANNED"}}}, "then": {"properties": {"observedPhysical": {"type": "null"}, "observedCompanions": {"maxItems": 0}, "intentAt": {"type": "null"}, "completedAt": {"type": "null"}}}},
        {"if": {"properties": {"state": {"const": "INTENT_DURABLE"}}}, "then": {"properties": {"observedPhysical": {"type": "null"}, "observedCompanions": {"maxItems": 0}, "intentAt": {"$ref": "#/$defs/timestamp"}, "completedAt": {"type": "null"}}}},
        {"if": {"properties": {"state": {"const": "COMPLETED"}}}, "then": {"properties": {"observedPhysical": {"allOf": [{"$ref": "lifecycle-projection-v2.schema.json"}, {"properties": {"schemaId": {"const": "file-object-v2"}}}]}, "observedCompanions": {"minItems": 1, "maxItems": 1, "items": {"allOf": [{"$ref": "lifecycle-projection-v2.schema.json"}, {"properties": {"schemaId": {"const": "directory-binding-v2"}}}]}}, "intentAt": {"$ref": "#/$defs/timestamp"}, "completedAt": {"$ref": "#/$defs/timestamp"}}}}
      ]
    },
    "completedStep": {"allOf": [{"$ref": "#/$defs/step"}, {"properties": {"state": {"const": "COMPLETED"}}}]}
  }
}
