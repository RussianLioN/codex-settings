{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-settings.local/schemas/context-bundle-v1.schema.json",
  "title": "context-bundle-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractVersion",
    "bundleId",
    "maxBytes",
    "totalBytes",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "contractVersion": {
      "const": "codex-context-bundle-v1"
    },
    "bundleId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "maxBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65536
    },
    "totalBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65536
    },
    "entries": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contextRefId",
        "kind",
        "required",
        "sourceEvidenceRefs",
        "sha256",
        "byteLength",
        "content"
      ],
      "properties": {
        "contextRefId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
        },
        "kind": {
          "enum": [
            "task-request",
            "repository-instruction",
            "source-excerpt",
            "dependency-summary",
            "policy-excerpt",
            "validation-result"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "sourceEvidenceRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "evidenceRefId",
              "evidenceSha256"
            ],
            "properties": {
              "evidenceRefId": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
              },
              "evidenceSha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "content": {
          "type": "string",
          "maxLength": 65536
        }
      }
    }
  }
}
