    "activationPreparationFrozenJournal": {"$ref": "#/$defs/spec", "properties": {"domain": {"const": "codex-smart/activation-preparation-frozen-journal/v2"}, "projectionFields": {"const": ["schemaVersion", "journalKind", "installationId", "operationId", "phase", "definitionFingerprint", "definition", "intentBoundary", "steps", "contentGeneration", "createdAt", "updatedAt", "frozenAt", "frozenJournalFingerprint", "desired"]}, "excludedFields": {"const": ["journalFingerprint"]}}},
